{
  "opencollection": "1.0.0",
  "info": {
    "name": "Manhattan Active Omni Order Management Inbound Returns API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "oauth2",
      "flow": "client_credentials",
      "accessTokenUrl": "https://auth.developer.manh.com/oauth2/token",
