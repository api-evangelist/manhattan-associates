            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.developer.manh.com/omni/v1/returns",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Initiate a customer return or exchange for a fulfilled order."
        }
      ]
    }
  ],
  "bundled": true
}