{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/OrderCreateRequest",
  "title": "OrderCreateRequest",
  "type": "object",
  "required": [
    "channelId",
    "customerId",
    "shippingAddress",
    "lines"
  ],
  "properties": {
    "externalOrderId": {
      "type": "string"
    },
    "channelId": {
      "type": "string"
    },
    "customerId": {
      "type": "string"
    },
    "orderDate": {
      "type": "string",
      "format": "date-time"
    },
    "requiredDeliveryDate": {
      "type": "string",
      "format": "date"
    },
    "shippingAddress": {
      "$ref": "#/components/schemas/Address"
    },
    "lines": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/components/schemas/OrderLineRequest"
      }
    },
    "shippingMethod": {
      "type": "string"
    }
  }
}