{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "#/components/schemas/AvailabilityRequest",
  "title": "AvailabilityRequest",
  "type": "object",
  "required": [
    "items"
  ],
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "itemId",
          "quantity"
        ],
        "properties": {
          "itemId": {
            "type": "string"
          },
          "quantity": {
            "type": "number"
          }
        }
      }
    },
    "deliveryAddress": {
      "$ref": "#/components/schemas/Address"
    },
    "channelId": {
      "type": "string"
    }
  }
}